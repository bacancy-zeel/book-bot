# Chat only — embeddings run locally via fastembed (ONNX BGE), so this key is
# used once per question and never for bulk indexing.
GEMINI_API_KEY=replace-me
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Tried in order when the model above hits its daily free-tier quota
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Reasoning tokens before answering. 0 is ~5x faster; raise it for harder questions
GEMINI_THINKING_BUDGET=0

# Vector storage. The index is created on first use if it does not exist:
# 768-dim, cosine, serverless.
PINECONE_API_KEY=replace-me
PINECONE_INDEX=book-bot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional: partitions one index. Empty means Pinecone's default namespace.
PINECONE_NAMESPACE=

BOOKS_CSV=./data/book.csv
# 768-dim; BAAI/bge-small-en-v1.5 is the 384-dim, faster option. Changing this
# changes the vector width, so it needs a new index and a rebuild.
EMBED_MODEL=BAAI/bge-base-en-v1.5
# Rows embedded per forward pass — a memory knob. See rag/config.py.
EMBED_BATCH=32
# Must be writable. On a serverless host only /tmp is.
EMBED_CACHE_DIR=/tmp/fastembed_cache

# Read-only source for `python -m rag.migrate` and `browse.py`
CHROMA_DIR=./chroma_data
COLLECTION=books

TOP_K=5
MIN_SIMILARITY=0.15
