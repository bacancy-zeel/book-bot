# Chat only — embeddings run locally via ChromaDB's ONNX MiniLM, so this key
# is used once per question and never for bulk indexing.
GEMINI_API_KEY=replace-me
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Tried in order when the model above hits its daily free-tier quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

BOOKS_CSV=./data/book.csv
CHROMA_DIR=./chroma_data
# 768-dim; BAAI/bge-small-en-v1.5 is the 384-dim, faster option.
# Changing this requires a `python -m rag.ingest --reset` rebuild.
EMBED_MODEL=BAAI/bge-base-en-v1.5
COLLECTION=books
# Where the sidebar's chat history is kept
HISTORY_DB=./chat_history.sqlite3

TOP_K=5
MIN_SIMILARITY=0.15
